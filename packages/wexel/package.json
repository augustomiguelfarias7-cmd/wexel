{
  "name": "wexel",
  "version": "4.0.0",
  "description": "Wexel: runtime WebAssembly com VFS, shell, NodeExecution e suporte a múltiplas linguagens (JS/TS, Go, Zig, Ruby, Python).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node-cpython.d.ts",
      "import": "./dist/node-cpython.js"
    },
    "./node-execution": {
      "types": "./dist/node-execution.d.ts",
      "import": "./dist/node-execution.js"
    },
    "./busybox": {
      "types": "./dist/busybox.d.ts",
      "import": "./dist/busybox.js"
    },
    "./orchester": {
      "types": "./dist/wexel-orchester.d.ts",
      "import": "./dist/wexel-orchester.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-wasm-memory64 ../../node_modules/vitest/vitest.mjs run --pool=threads --poolOptions.threads.singleThread",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.3.0",
    "@wexel/core": "0.1.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
